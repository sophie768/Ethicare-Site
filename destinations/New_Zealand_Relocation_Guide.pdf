425 0 obj
<<
/Type /StructElem
/S /P
/ActualText (1. Communication: )
/Pg 19 0 R
/K [11]
>>
endobj
426 0 obj
<<
/Type /StructElem
/S /P
/ActualText (Start early and have open, age-appropriate conversations with your children about the move. Encourage them to express their feelings and ask questions)
/Pg 19 0 R
/K [12]
>>
endobj
427 0 obj
<<
/Type /StructElem
/S /Figure
/P 240 0 R
/Pg 19 0 R
/K [10]
>>
endobj
