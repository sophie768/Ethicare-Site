<<
/Type /StructElem
/S /P
/ActualText (4 Maintain Routine:)
/Pg 19 0 R
/K [8]
>>
endobj
433 0 obj
<<
/Type /StructElem
/S /P
/ActualText (Keep a sense of routine as much as possible. Consistency in daily schedules can provide stability and comfort during a time of change.)
/Pg 19 0 R
/K [9]
>>
endobj
