<<
/Type /StructElem
/S /P
/P 1081 0 R
/ActualText (2. Listen and Validate)
/Pg 19 0 R
/K [4]
>>
endobj
429 0 obj
<<
/Type /StructElem
/S /P
/P 1082 0 R
/ActualText (Listen to your children's concerns and feelings. Validate their emotions and reassure them that it's okay to feel a range of emotions, including excitement and anxiety.)
/Pg 19 0 R
/K [5]
>>
endobj
430 0 obj
<<
/Type /StructElem
/S /P
/ActualText (3. Pack Together:)
/Pg 19 0 R
/K [6]
>>
endobj
431 0 obj
<<
/Type /StructElem
/S /P
/ActualText (Involve your children in the packing process. Let them choose a few items to bring with them that hold sentimental value.)
/Pg 19 0 R
/K [7]
>>
endobj
